<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyrus Tech Web Studio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            color: white;
            line-height: 1.6;
        }

        header {
            background-color: #111827;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h2 {
            color: #38bdf8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 15px;
        }

        .hero {
            min-height: 65vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;
        }

        .hero h1 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero span {
            color: #38bdf8;
        }

        .hero p {
            max-width: 600px;
            color: #cbd5e1;
            margin-bottom: 25px;
        }

        .button {
            background-color: #38bdf8;
            color: #0f172a;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

        .services {
            background-color: #1e293b;
            padding: 50px 8%;
            text-align: center;
        }

        .services h2 {
            color: #38bdf8;
            margin-bottom: 25px;
        }

        .cards {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .card {
            background-color: #0f172a;
            padding: 25px;
            border-radius: 12px;
            flex: 1 1 200px;
            max-width: 300px;
        }

        .card h3 {
            margin-bottom: 10px;
            color: #38bdf8;
        }

        .card p {
            color: #cbd5e1;
        }

        footer {
            padding: 25px;
            text-align: center;
            color: #cbd5e1;
        }

        @media (max-width: 600px) {
            header {
                flex-direction: column;
                gap: 10px;
            }

            nav a {
                margin: 0 5px;
            }

            .hero h1 {
                font-size: 30px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h2>CYRUS TECH</h2>

        <nav>
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section class="hero" id="home">
        <h1>Welcome to <span>Cyrus Tech</span></h1>

        <p>
            We build modern websites and digital solutions
            to help Kenyan businesses grow online.
        </p>

        <a href="#services" class="button">
            Explore Our Services
        </a>
    </section>

    <section class="services" id="services">
        <h2>Our Services</h2>

        <div class="cards">

            <div class="card">
                <h3>Website Design</h3>
                <p>Beautiful websites for small businesses.</p>
            </div>

            <div class="card">
                <h3>Web Development</h3>
                <p>Useful websites built with modern technology.</p>
            </div>

            <div class="card">
                <h3>Cybersecurity</h3>
                <p>Learning to protect websites and digital systems.</p>
            </div>

        </div>
    </section>

    <footer id="contact">
    <h2>Let's Work Together!</h2>

    <p>Need a website for your business?</p>

    <a
        class="button"
        href="https://wa.me/2547XXXXXXXX"
        target="_blank"
        rel="noopener noreferrer"
    >
        Contact Us on WhatsApp
    </a>

    <p>&copy; 2026 Cyrus Tech Web Studio</p>
    </footer>

</body>
</html>
